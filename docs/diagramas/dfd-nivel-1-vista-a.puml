@startuml
' DFD nivel 1, vista 1A: procesos y personas. Flujos de docs/01-dfd.md §2, verificados contra
' services/api/app/api/v1/, services/api/app/tasks/ y apps/web. Pasado de Mermaid a PlantUML el 2026-09-22 (Decisión 18).
' Las vistas 1A, 1B y 1C son el mismo nivel 1 con los mismos procesos y la misma numeración.
' Las respuestas se escriben «destino <-- origen» para que el dibujo no las acomode como vueltas.
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #4A5568
skinparam ArrowFontSize 11
skinparam ArrowFontColor #2D3748
skinparam RectangleBorderColor #4A5568
skinparam UsecaseBorderColor #4A5568
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #9AA5B1

title DFD nivel 1 — Vista 1A: procesos y personas

rectangle "Persona\nusuaria" as U #D5EBE3
rectangle "Administrador\n(planificado)" as A #F1F1F1;line.dashed

rectangle "Sistema Jobby" as SIS #FFFFFF {
  usecase "1\nGestionar cuenta\ny acceso" as P1 #D6E2F3
  usecase "2\nProcesar CV\ny perfil" as P2 #D6E2F3
  usecase "3\nAnalizar\npuesto" as P3 #D6E2F3
  usecase "4\nEvaluar\ncompatibilidad" as P4 #D6E2F3
  usecase "5\nGenerar kit\nde entrevista" as P5 #D6E2F3
  usecase "6\nGestionar\nsuscripción" as P6 #D6E2F3
  usecase "7\nConsultar métricas\n(planificado)" as P7 #F1F1F1;line.dashed
}

U --> P1 : F1 Credenciales y datos de registro\nF7 Solicitud de baja de cuenta
U <-- P1 : F18 Confirmación de baja
U --> P2 : F2 CV en PDF\nF3 Datos del perfil
U <-- P2 : F11 Perfil estructurado del CV\nF15.2 Estado de la tarea
U --> P3 : F4 Oferta laboral
U <-- P3 : F15.3 Estado de la tarea
P3 --> P4 : Identificadores de puesto y perfil
U --> P4 : F5.1 Valoración del match\nF8 Solicitud de CV optimizado
U <-- P4 : F12 Resultados de compatibilidad\nF13 CV optimizado\nF17 Resumen del panel\nF15.4 Estado de la tarea
U --> P5 : F9 Solicitud de kit de entrevista\nF5.2 Valoración del kit
U <-- P5 : F14 Kit de entrevista\nF15.5 Estado de la tarea
U --> P6 : F6 Solicitud de plan premium
U <-- P6 : F16 Enlace de pago
A --> P7 : F19 Solicitud de métricas
A <-- P7 : F20 Métricas agregadas de uso

legend right
  |<#D5EBE3>      | Entidad externa: persona |
  |<#D6E2F3>      | Proceso del nivel 1 |
  |<#F1F1F1>      | Planificado: todavía no existe |
  Los sistemas externos están en la vista 1B y los almacenes, en la vista 1C.
endlegend
@enduml
