@startuml
' DFD nivel 1, vista 1C: procesos y almacenes de datos. Flujos de docs/01-dfd.md §2, verificados contra
' services/api/app/api/v1/, services/api/app/tasks/, las migraciones y apps/web. Pasado de Mermaid a PlantUML
' el 2026-09-22 (Decisión 18). Una flecha doble indica que el proceso lee y escribe en el almacén.
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #4A5568
skinparam ArrowFontSize 11
skinparam ArrowFontColor #2D3748
skinparam UsecaseBorderColor #4A5568
skinparam DatabaseBorderColor #4A5568
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #9AA5B1

title DFD nivel 1 — Vista 1C: procesos y almacenes de datos

usecase "1\nGestionar cuenta\ny acceso" as P1 #D6E2F3
usecase "2\nProcesar CV\ny perfil" as P2 #D6E2F3
usecase "3\nAnalizar\npuesto" as P3 #D6E2F3
usecase "4\nEvaluar\ncompatibilidad" as P4 #D6E2F3
usecase "5\nGenerar kit\nde entrevista" as P5 #D6E2F3
usecase "6\nGestionar\nsuscripción" as P6 #D6E2F3
usecase "7\nConsultar métricas\n(planificado)" as P7 #F1F1F1;line.dashed

database "D1\nUsuarios y planes" as D1 #E3F1EC
database "D2\nPerfil maestro" as D2 #E3F1EC
database "D3\nDocumentos de CV" as D3 #E3F1EC
database "D4\nPuestos" as D4 #E3F1EC
database "D5\nResultados de\ncompatibilidad" as D5 #E3F1EC
database "D6\nKits de entrevista" as D6 #E3F1EC
database "D7\nCaché de LinkedIn" as D7 #E3F1EC
database "D8\nEstado de tareas\ny límites" as D8 #EDEFF2

P1 --> D1 : Datos de cuenta y plan
P1 --> D3 : Orden de borrado de archivos
P1 --> D7 : Orden de borrado de caché
P1 --> D8 : Orden de invalidar claves
P2 --> D3 : CV y estado de procesamiento
P2 --> D2 : Perfil estructurado
P3 --> D4 : Puesto estructurado con vector
D1 --> P4 : Plan de la persona
D2 --> P4 : Perfil y habilidades
D4 --> P4 : Puesto estructurado
D3 --> P4 : Texto del CV principal
P4 <--> D5 : Resultados de compatibilidad
D1 --> P5 : Plan de la persona
D2 --> P5 : Perfil y habilidades
D4 --> P5 : Puesto estructurado
P5 --> D6 : Kit de entrevista
P5 <--> D7 : Perfiles de LinkedIn en caché
P6 <--> D1 : Suscripción y plan
P2 <--> D8 : Estado de la tarea
P3 <--> D8 : Estado de la tarea
P4 <--> D8 : Estado de la tarea
P5 <--> D8 : Estado de la tarea
P6 <--> D8 : Eventos ya procesados
D1 --> P7 : Conteos agregados
D4 --> P7 : Conteos agregados
D5 --> P7 : Conteos agregados
D6 --> P7 : Conteos agregados

legend right
  |<#D6E2F3>      | Proceso del nivel 1 |
  |<#F1F1F1>      | Planificado: todavía no existe |
  |<#E3F1EC>      | Almacén en Supabase (tablas y Storage) |
  |<#EDEFF2>      | Almacén en Redis |
  Flecha doble: el proceso lee y escribe en el almacén.
endlegend
@enduml
